rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function classMember(classId) {
      return signedIn()
        && request.auth.token.classId == classId
        && request.auth.token.role in ['teacher', 'student'];
    }
    function isTeacher(classId) {
      return signedIn()
        && request.auth.token.role == 'teacher'
        && request.auth.token.classId == classId;
    }

    match /classes/{classId} {
      allow read: if classMember(classId);
      // Class metadata is provisioned only by a trusted Admin SDK script.
      allow write: if false;

      match /students/{studentId} {
        allow read: if classMember(classId);
        // Only the teacher assigned to this class can create, update, or delete profiles.
        allow create: if isTeacher(classId)
          && request.resource.data.keys().hasOnly(['name', 'avatar', 'xp', 'createdAt'])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 60
          && request.resource.data.avatar is string
          && request.resource.data.xp == 0;
        allow update: if isTeacher(classId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['xp', 'name', 'avatar'])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 60
          && request.resource.data.xp is int
          && request.resource.data.xp >= resource.data.xp
          && request.resource.data.xp <= resource.data.xp + 100;
        allow delete: if isTeacher(classId);
      }

      match /announcements/{announcementId} {
        allow read: if classMember(classId);
        allow create: if isTeacher(classId)
          && request.resource.data.keys().hasOnly(['title', 'message', 'createdAt', 'authorId'])
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 90
          && request.resource.data.message is string
          && request.resource.data.message.size() > 0
          && request.resource.data.message.size() <= 1000
          && request.resource.data.authorId == request.auth.uid;
        allow update, delete: if isTeacher(classId);
      }

      match /activityHistory/{activityId} {
        allow read: if classMember(classId);
        allow create: if isTeacher(classId)
          && request.resource.data.keys().hasOnly(['studentId', 'xp', 'reason', 'createdAt', 'awardedBy'])
          && request.resource.data.studentId is string
          && request.resource.data.xp is int
          && request.resource.data.xp >= 1
          && request.resource.data.xp <= 100
          && request.resource.data.reason is string
          && request.resource.data.reason.size() <= 140
          && request.resource.data.awardedBy == request.auth.uid;
        allow update, delete: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
